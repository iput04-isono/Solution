<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- カメラ使用権限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- インターネット・ネットワーク状態確認権限（同期機能用） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 画像ファイル読取権限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".CrossVisionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrossVisionF"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- ログイン画面（起動画面） -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 工事・工程選択画面 -->
        <activity
            android:name=".ui.process.ProcessSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 画像認識画面 -->
        <activity
            android:name=".ui.recognize.RecognizeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- カメラ画面 -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 認識結果確認画面 -->
        <activity
            android:name=".ui.confirm.ConfirmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 登録画面 -->
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 登録履歴画面 -->
        <activity
            android:name=".ui.library.LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
