<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ツールバー -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/confirm_title"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- スクロール可能なコンテンツ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 認識領域オーバーレイ画像 -->
            <ImageView
                android:id="@+id/ivOverlay"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="fitCenter"
                android:background="#111111"
                android:visibility="gone"
                android:contentDescription="認識領域の確認画像" />

            <!-- 工事・工程情報表示エリア -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md"
                android:background="@color/surface"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="登録先"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvProcessInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未設定"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProcess"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="変更" />
            </LinearLayout>

            <!-- 認識結果カウント -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md"
                android:background="@color/primary_light"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddManual"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_add_manual"
                    android:textColor="@color/on_primary" />

            </LinearLayout>

            <!-- 認識結果リスト（ラベル距離 ≤ 3） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- 結果なしメッセージ -->
            <LinearLayout
                android:id="@+id/emptyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_no_results"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- マッチなし枠（ラベル距離 > 3 の参考表示） -->
            <LinearLayout
                android:id="@+id/unmatchedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/spacing_md"
                android:padding="@dimen/spacing_md"
                android:background="#FFF3CD"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="参考：正解ラベルと一致しなかった認識結果"
                    android:textSize="12sp"
                    android:textColor="#856404"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvUnmatchedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="（編集距離 > 3。登録には使用されません）"
                    android:textSize="11sp"
                    android:textColor="#856404"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/unmatchedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 下部ボタン（固定） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:background="@color/surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:layout_weight="1"
            android:text="再撮影"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/confirm_register_selected" />

    </LinearLayout>

</LinearLayout>
