<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- カメラプレビュー -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- リアルタイム検出枠オーバーレイ（PreviewViewの上に透明で重ねる） -->
    <com.crossvision.f.ui.camera.DetectionOverlayView
        android:id="@+id/detectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />


    <!-- 上部ツールバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md"
        android:background="@color/camera_overlay">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="閉じる"
            app:tint="@color/on_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/camera_title"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_subtitle"
            android:textAlignment="center" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- 下部コントロール -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_lg"
        android:background="@color/camera_overlay">

        <!-- 撮影ガイドテキスト -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="鉄骨の製品番号が見えるように撮影してください"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_caption"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- シャッターボタン -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCapture"
            android:layout_width="@dimen/camera_button_size"
            android:layout_height="@dimen/camera_button_size"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="撮影"
            app:backgroundTint="@color/on_primary"
            app:tint="@color/primary"
            app:fabSize="normal"
            app:elevation="6dp" />

    </LinearLayout>

</FrameLayout>
